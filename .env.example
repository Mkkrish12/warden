# ------------------------------------------------------------
# Warden environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
# ------------------------------------------------------------

# --- Monad (on-chain policy + payment registry) ---
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Deployer / agent signing key — TESTNET key only, never commit a real key.
DEPLOYER_PRIVATE_KEY=
# Address of the deployed APPolicy contract — filled in after deploy.
POLICY_CONTRACT_ADDRESS=

# --- Rain (scoped virtual card issuance + settlement) ---
# Without RAIN_API_KEY and RAIN_USER_ID the agent falls back to the stub issuer,
# and every surface labels the cards as stubbed.
RAIN_API_KEY=                          # sent as the `Api-Key` header
RAIN_USER_ID=                          # used in the card-create URL path
RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_COLLATERAL_CONTRACT_ID=           # not needed for card creation
# Unused: sandbox settlement is simulated via /simulate endpoints, not webhooks.
RAIN_WEBHOOK_SECRET=

# Verify credentials before demoing:  pnpm rain:smoke

# --- Slack (human-in-the-loop + receipts) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=
# Socket Mode needs no public URL — leave true for the venue demo.
# Set false to run an HTTP receiver (then SLACK_SIGNING_SECRET is required).
SLACK_SOCKET_MODE=true
SLACK_PORT=3001

# --- Agent behaviour ---
# escalate = route policy failures to Slack for a human; block = auto-reject.
AGENT_BLOCKED_MODE=escalate
# Pause between invoices so the demo reads at human speed.
AGENT_STEP_DELAY_MS=600
